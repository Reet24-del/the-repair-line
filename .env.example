# Copy this file to .env and set your Gemini key locally. Never commit .env.
GEMINI_API_KEY=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
# Production: use a TYPE=SERVICE user and its limited application role.
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_ROLE=
SNOWFLAKE_PRIVATE_KEY=
# Only needed if the PEM private key is encrypted.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Legacy local/admin setup only; not used with key-pair authentication.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
